# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x4033 arranque INIT del cartucho: pone el cartucho en la pagina 2 (ENASLT), borra la RAM 0xC000-0xF0EF y 0xD500-0xDCFF, la pila en 0xF0F0, el gancho H.KEYI a p00:4110 y salta a p00:42F2
L 0x4083 gancho_de_partida pone el gancho H.KEYI en p00:4270 (la interrupcion con lineas)
L 0x4100 vector_cuadro_de_partida jp p00:438E
L 0x4103 vector_empieza_fase jp p00:4492
L 0x4106 vector_vacio jp p00:4452, que es un ret
L 0x4109 vector_4109 jp p00:458B
L 0x4110 interrupcion el gancho H.KEYI: cuenta 0xC914, cada dos cuadros p00:4A6A, el fundido de p00:4D6E y, si no hay otro cuadro a medias (0xC906), guarda los bancos, llama a p00:4B4A con interrupciones y los devuelve
L 0x414E lee_estado_vdp lee el registro de estado del VDP (el puerto de 0x0006 + 1): asi se da por atendida la interrupcion
L 0x4158 interrupcion_saltable el gancho de p00:410C: la interrupcion de p00:4270 y, si se acaba de pulsar el disparo (bit 4 de 0xC90A) y no hay cuadro a medias, salta al estado de 0xC945 con la pila de nuevo en 0xF0F0
L 0x4189 lineas_del_vdp en el borde: manda la lista de registros de 0xC0AE (cuantos y los bytes, con otir) y la primera vez cambia de tablas (p00:41C2) y enciende la interrupcion de linea (bit 4 del registro 0)
L 0x4197 manda_registros la lista de 0xC0AE al puerto de registros del VDP: un byte con cuantos y los bytes (otir)
L 0x41C2 tablas_actuales las tablas de registros que tocan con 0xC09B
L 0x41C7 cambia_tablas cambia de pagina (p00:41FA si 0xC0B5), sube 0xC09B y, segun su bit 0, apunta 0xC0A4, 0xC0AC y 0xC0AE a un juego de tablas o al otro
L 0x41FA pon_pagina_vdp con 0xC0B4 escribe los registros 10, 3 y 4 del VDP (las tablas de colores y de patrones)
L 0x4255 interrupcion_del_borde la interrupcion no era de linea: si el estado 0 dice que es el borde, p00:4189 y p00:4110
L 0x4270 interrupcion_de_lineas el gancho en partida: si el estado 1 del VDP no dice linea, p00:4255; si dice, espera el borrado horizontal (estado 2, bit 5) y manda la lista de registros de 0xC0AC (la primera) o la de 0xC0A4 (la segunda)
L 0x42F2 inicio borra fase, vidas y estado; pasa por los estados 1 y 2 al ritmo de 0xC914; pone el gancho de lineas, guarda la fase - 1 en 0xF0FC y las vidas en 0xF0FD, borra la RAM y sigue en p00:4357
L 0x4357 bucle_principal cada vuelta: mandos (p00:4A7A, p00:4A58), reinicio con el bit 7 de 0xC90C, bancos 1-2-3 y p01:6000; luego espera a que 0xC914 pase de 0 (o de 2 desde el estado 2) contando las vueltas en 0xC915
L 0x438E cuadro_de_partida la pausa y luego, apuntando en 0xF0FA por que paso va, las partes de la partida en los bancos 1, 9, 4, 2 y 7; acaba con p00:440F
L 0x440F como_va_la_fase A = 2 si la fase esta acabada (0xCA0F), 1 si 0xCA40 es 0, 0 si sigue; si el byte 0x4032 no es 0xFF, el bit 3 de 0xC90C tambien acaba la fase
L 0x4432 depuracion_vida con el bit 2 de 0xC90C sube 0xCA1E (0 a 5) y una vida
L 0x4452 nada ret
L 0x4453 pausa con el bit 0 de 0xC90C (y no en el estado 5 ni con 0xCA41): el sonido 0x82, espera a que se vuelva a pulsar y el sonido 0x81
L 0x448B sube_ca02_y_cuadro sube 0xCA02 y sigue en el cuadro de partida (p00:4391)
L 0x4492 empieza_fase segun A: 0 partida nueva, 1, 2 (resta 2 a 0xCB08) y 3 o mas; prepara la fase con p00:44E9 y lo que toque de los bancos 2 y 4
L 0x44D9 vidas_al_empezar las vidas de 0xF0FD (o 2 si es 0) a 0xCB0F
L 0x44E9 prepara_fase sin el bit 1 de 0xCA03 borra 0xE900; las preparaciones de los bancos 4, 9 y 1, el sonido 0x55 y la musica de la fase (tabla p00:4AE2)
L 0x453D prepara_banco_2 p02:8003 con los bancos 4-2-3
L 0x4555 prepara_banco_2_b p02:8012 con los bancos 4-2-3
L 0x456D llama_8018 p02:8018 con los bancos 4-2-3
L 0x4577 llama_6018 p04:6018 con los bancos 4-2-3
L 0x4581 llama_601B p04:601B con los bancos 4-2-3
L 0x458B llama_6000_6012 p04:6000 y p04:6012 con los bancos 4-5-6 y luego los 9-10
L 0x4598 borra_ca1e fuera del estado 5, 0xCA1E a 0
L 0x4600 suma_a_hl HL = HL + A
L 0x4605 suma_a_de DE = DE + A
L 0x460A niega_de DE = -DE
L 0x4612 niega_hl HL = -HL
L 0x461A despachador salta a la entrada A de la tabla de direcciones que va detras del call
L 0x4624 entrada_de_tabla_de HL = la palabra A de la tabla de DE
L 0x462E entrada_de_tabla_hl HL = la palabra A de la tabla de HL (pasando por DE)
L 0x4639 dos_palabras_de_tabla de la tabla de DE con 4 bytes por entrada: DE = la primera palabra de la entrada A, HL = la segunda
L 0x4648 borra_memoria pone a 0 BC + 1 bytes desde HL
L 0x4649 llena_memoria pone A en BC + 1 bytes desde HL
L 0x4650 compara_hl_de Z si HL = DE
L 0x4656 cambia_ix_iy cambia IX por IY
L 0x465F slot_del_cartucho el slot de la pagina 1 (RSLREG, EXPTBL y SLTTBL) en el formato de ENASLT
L 0x4678 numero_al_azar A al azar: byte(0x4600 + C) xor B xor byte(0x4700 + C), con B y C en 0xC917
L 0x468E entrada_de_tabla HL = la palabra A de la tabla de HL
L 0x4694 lee_palabra HL = la palabra que apunta HL
L 0x4699 vuelve_quitando_4 quita 4 palabras de la pila y vuelve: no vuelve a quien llama sino mas atras
L 0x469B vuelve_quitando_3 quita 3 palabras de la pila y vuelve
L 0x469D vuelve_quitando_2 quita 2 palabras de la pila y vuelve
L 0x469F vuelve_quitando_1 quita 1 palabra de la pila y vuelve
L 0x46A2 vuelve ret
L 0x46A3 vueltas_de_otir de BC a las vueltas de otir: B = C (bytes de la primera) y A = B, mas 1 si C no es 0
L 0x46AB copia_a_vram_alta copia BC bytes de HL a la VRAM en DE, en los 64 KB altos
L 0x46AC copia_a_vram_baja copia BC bytes de HL a la VRAM en DE, en los 64 KB bajos
L 0x46AD copia_a_vram copia BC bytes de HL a la VRAM en DE; el bit 0 de A es el bit 16 de la direccion
L 0x46C0 llena_vram_alta pone A en BC bytes de la VRAM desde HL, en los 64 KB altos
L 0x46C5 llena_vram_baja pone A en BC bytes de la VRAM desde HL, en los 64 KB bajos
L 0x46E1 escribe_byte_vram pone A en la direccion HL de la VRAM (64 KB bajos)
L 0x46F0 direccion_vram apunta el VDP a escribir en HL (el bit 0 de A, bit 16; registro 14)
L 0x4713 escribe_registro_vdp pone B en el registro C del VDP
L 0x4725 prepara_vdp esconde los sprites, apaga la pantalla, borra la VRAM con una orden del VDP (p00:47FC), el registro 23 a 0 y enciende la pantalla
L 0x473E enciende_pantalla el bit 6 del registro 1 (copia en 0xF3E0)
L 0x474A nada_474A ret
L 0x474B apaga_pantalla quita el bit 6 del registro 1 y apaga los sprites (p00:4760)
L 0x4758 esconde_sprites pone 0xD8 (la Y que acaba la lista) en el primer sprite, en 0xF600 de la VRAM
L 0x4760 apaga_sprites el bit 1 del registro 8 (copia en 0xFFE7)
L 0x476B enciende_sprites quita el bit 1 del registro 8
L 0x4776 pon_color el color A de la paleta (registro 16) con los bytes D y E por el puerto de la paleta
L 0x4790 paleta_inicial los 16 colores de la tabla p00:47A4
L 0x47C4 lista_de_colores pone los colores de HL: [color][D][E] hasta un 0xFF
L 0x47D2 espera_orden_vdp espera a que el VDP acabe su orden (estado 2, bit 0)
L 0x47DC lee_estado_vdp_a lee el registro de estado A del VDP y deja el 0 puesto
L 0x47FC orden_rellena orden HMMV del VDP (0xC0): rellena un rectangulo de la VRAM desde H, L con D y el valor de A
L 0x4838 orden_copia orden HMMM del VDP (0xD0): copia un rectangulo de la VRAM a otro sitio
L 0x487C orden_copia_logica orden LMMM del VDP (0x90 y la operacion logica): copia un rectangulo con transparencia u otra operacion
L 0x48C8 pon_tablas_vdp guarda A en 0xFAF5 y escribe los registros 2, 10, 4, 11 y 6 del VDP mezclando A con las copias de 0xF3E1-0xF3E5
L 0x490B copia_caracter copia 8 filas de 4 bytes de HL a la VRAM en DE (un caracter de 8 x 8 de SCREEN 5: 0x80 bytes por linea)
L 0x4921 copia_rectangulo copia B filas de C bytes de HL a la VRAM en DE, 0x80 bytes por linea (p00:4933)
L 0x4933 copia_a_vram_segun_pagina copia BC bytes a la VRAM, en los 64 KB bajos si 0xC91B es 0 y en los altos si no
L 0x493D copia_caracteres B caracteres de p00:490B seguidos, 8 puntos a la derecha cada uno y bajando al llegar al borde
L 0x4952 copia_bloque_16 copia 16 filas de 8 bytes de HL a la VRAM en DE (16 x 16 puntos)
L 0x4967 escribe_texto el texto de HL: posicion D, E, letras (p00:4983) y 0xFE con otra posicion; 0xFF acaba
L 0x496B borra_texto el mismo recorrido con cada letra a 0
L 0x4983 pinta_letra copia la letra A de la fuente de la VRAM (p00:49CB) a D, E: orden HMMM de 8 x 8
L 0x4995 pinta_letra_b igual que p00:4983
L 0x49A7 pinta_letra_transparente la letra A con una copia logica (p00:487C, A = 0x48)
L 0x49B9 pinta_letra_c la letra A con p00:4838 y A = 5
L 0x49CB sitio_de_la_letra de la letra A, donde esta en la fuente: H = (A and 0x1F) x 8, L = (A and 0xE0) / 4
L 0x49D9 avanza_8_puntos D + 8 y, si da la vuelta, E + 8
L 0x49E3 prepara_arranque el sonido (p28:6000 con A = 0xB8), la musica 0x55, el borde, los registros del VDP de p00:4A30, la paleta, borra las dos paginas de la VRAM y enciende la pantalla
L 0x4A1D lista_de_registros B parejas [registro][valor] de HL al VDP con WRTVDP
L 0x4A58 teclas_de_funcion F1-F5 (p00:4AC8) en 0xC90D y las recien pulsadas en 0xC90C (bit 0 F1 ... bit 4 F5)
L 0x4A63 recien_pulsadas guarda A en (HL) y en (HL - 1) lo que se acaba de pulsar
L 0x4A6A mandos_del_cuadro lee los mandos (p00:4A8C) en 0xC909, lo recien pulsado en 0xC90A y lo junta en 0xC90B
L 0x4A7A copia_mandos 0xC909 a 0xC908 y 0xC90B a 0xC907, que se vacia
L 0x4A8C lee_mandos el joystick 1 (PSG 14 y 15) mas el teclado: cursores (fila 8), espacio (disparo) y M o N (boton 2); bit 0 arriba, 1 abajo, 2 izquierda, 3 derecha, 4 disparo, 5 boton 2
L 0x4AC8 lee_teclas_de_funcion F1-F5 (filas 6 y 7 del teclado) en los bits 0-4
L 0x4AE0 nada_4AE0 ret
L 0x4AEB pide_sonido mete A en la cola de sonidos de 0xC882 (hasta 0x1F); si ya estaba, lo pasa al final; nada si el bit 0 de 0xC947
L 0x4AF0 pide_sonido_b lo mismo con hasta 0x17 en la cola
L 0x4AF5 pide_musica lo mismo con hasta 0x17 en la cola
L 0x4B31 sonido_ahora con 0xC906 puesto: bancos 28-29-30, manda la cola (p00:4B5B) y un paso del sonido (p28:6006)
L 0x4B4A sonido_del_cuadro bancos 28-29-30, la cola si 0xC942 (p00:4B5B) y un paso del sonido (p28:6006)
L 0x4B5B manda_cola_de_sonidos cada sonido de la cola de 0xC882 a p28:6003 y vacia la cola
L 0x4B78 apaga_lineas borra 0xC940-0xC9FF y quita la interrupcion de linea (bit 4 del registro 0)
L 0x4B8F enciende_lineas 0xC940 = 1
L 0x4B95 bancos_1_2_3 pone el 1 en 0x6000, el 2 en 0x8000 y el 3 en 0xA000 (con su copia en 0xF0F1-0xF0F3)
L 0x4B99 bancos_4_5_6 pone el 4, el 5 y el 6
L 0x4BB0 bancos_4_7_8 pone el 4, el 7 y el 8
L 0x4BC8 bancos_28_29_30 pone el 28, el 29 y el 30 (el sonido)
L 0x4BDF bancos_9_10 pone el 9 en 0x6000 y el 10 en 0x8000
L 0x4BEF bancos_4_2_3 pone el 4, el 2 y el 3
L 0x4C07 banco_en_6000 pone el banco A en 0x6000
L 0x4C0E bancos_en_6000_8000 pone el banco A en 0x6000 y el A + 1 en 0x8000
L 0x4C15 banco_en_8000 pone el banco A en 0x8000
L 0x4C1C bancos_en_8000_A000 pone el banco A en 0x8000 y el A + 1 en 0xA000
L 0x4C23 banco_en_A000 pone el banco A en 0xA000
L 0x4C2A llamada_lejana lee detras del call los tres bancos y la direccion (5 bytes), los pone, llama y vuelve por p00:4C61 detras de los 5 bytes
L 0x4C61 vuelta_de_llamada_lejana devuelve los bancos de antes de la llamada lejana
L 0x4C7A paleta_a_negro apaga la pantalla, pone los 16 colores a 0 en 0xEF00, los manda y enciende la pantalla
L 0x4C94 pon_colores_ya espera al fundido y pone tal cual los colores de la lista de HL (p00:4CAF) hasta un byte 0xF0 o mayor
L 0x4CAF pon_color_ya un color de la lista: [rojo, azul][numero, verde] (cuatro nibbles) a su sitio en 0xEF00
L 0x4CD0 componente_ya un componente (0-7) en el formato de 0xEF00, en las dos casillas
L 0x4CDC prepara_paleta_ya 0xEF60 a 0 y p00:4CE0
L 0x4CE0 prepara_paleta espera al fundido de antes y apunta como destino los colores de la lista de HL (p00:4D01); al llegar a un byte 0xF0 o mayor, 0xEF60 = 0x80
L 0x4CF5 empieza_fundido 0xEF60 = 0x20: 32 pasos de fundido
L 0x4D01 color_de_destino un color de la lista como destino del fundido (p00:4D46 con cada componente)
L 0x4D27 fundido_a_negro los 16 colores con destino 0 y empieza el fundido
L 0x4D2B fundido_a_blanco los 16 colores con destino 7 y empieza el fundido
L 0x4D46 componente_de_destino apunta en 0xEF00 un componente de destino y lo que le falta
