# Puntos de entrada del banco 2 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador (cartucho.DESPACHADOR), que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8000   # jp 0 del vector de p02:8000
0x8003   # jp 1 del vector de p02:8000
0x8006   # jp 2 del vector de p02:8000
0x8009   # jp 3 del vector de p02:8000
0x800C   # jp 4 del vector de p02:8000
0x800F   # jp 5 del vector de p02:8000
0x8012   # jp 6 del vector de p02:8000
0x8015   # jp 7 del vector de p02:8000
0x8018   # jp 8 del vector de p02:8000
0x844A   # codigo huerfano: 1 bytes que acaban en ret; el trazado no entra y ninguna instruccion salta, llama o carga 0x844A
0x8451   # codigo huerfano: 6 bytes que acaban en ret; el trazado no entra y ninguna instruccion salta, llama o carga 0x8451
0x861E   # p02:8605 entrada 0 de la tabla de 0x8608 (call 0x461A en 0x8605)
0x8637   # codigo huerfano: 5 bytes que acaban en un salto; el trazado no entra y ninguna instruccion salta, llama o carga 0x8637
0x87BE   # p02:87A9 entrada 0 de la tabla de 0x87AC (call 0x461A en 0x87A9)
0x8877   # p02:87A9 entrada 8 de la tabla de 0x87AC (call 0x461A en 0x87A9)
0x889C   # p02:888D entrada 0 de la tabla de 0x8890 (call 0x461A en 0x888D)
0x88B0   # p02:888D entrada 1 de la tabla de 0x8890 (call 0x461A en 0x888D)
0x88C4   # p02:888D entrada 2 de la tabla de 0x8890 (call 0x461A en 0x888D)
0x88F9   # p02:888D entrada 3 de la tabla de 0x8890 (call 0x461A en 0x888D)
0x891C   # p02:888D entrada 4 de la tabla de 0x8890 (call 0x461A en 0x888D)
0x8934   # p02:888D entrada 5 de la tabla de 0x8890 (call 0x461A en 0x888D)
0x8BF1   # p02:8605 entrada 10 de la tabla de 0x8608 (call 0x461A en 0x8605)
0x8C9C   # p02:8605 entrada 1 de la tabla de 0x8608 (call 0x461A en 0x8605)
0x8D29   # codigo huerfano: 37 bytes que acaban en ret; el trazado no entra y ninguna instruccion salta, llama o carga 0x8D29
0x8D4E   # p02:87A9 entrada 4 de la tabla de 0x87AC (call 0x461A en 0x87A9)
0x8E50   # p02:8605 entrada 3 de la tabla de 0x8608 (call 0x461A en 0x8605)
0x8E9B   # p02:87A9 entrada 7 de la tabla de 0x87AC (call 0x461A en 0x87A9)
