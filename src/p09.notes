# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6D00 vector_graficos_de_fase jp p10:801F (los graficos de la fase A)
L 0x6D03 vector_80F4 jp p10:80F4
L 0x6D06 vector_reinicio jp 0x0000
L 0x6D09 vector_graficos_b jp p10:800F
L 0x6D0C vector_graficos_a jp p10:8000
L 0x6D0F vector_prepara_pantalla jp p09:6D30
L 0x6D12 vector_pantalla_del_cuadro jp p09:6E44
L 0x6D15 vector_scroll_del_cuadro jp p09:6D95
L 0x6D18 vector_prepara_registros jp p09:6D69
L 0x6D1B vector_nada jp p09:707D, que es un ret
L 0x6D30 prepara_pantalla_de_fase los registros (p09:6D75), los graficos de la fase (p10:801F), sprites, borra 0xC000-0xC5FF; si el VDP es un V9958 (estado 1, bits 1-5 = 2) 0xC0EB = 4 y el registro 25 = 2; luego p09:77FC, p09:7683, las tablas de registros (p09:6F99), las lineas y las estrellas (p09:6E77)
L 0x6D69 prepara_registros los registros, las tablas de registros, sprites y lineas
L 0x6D75 registros_de_pantalla los 9 registros de p09:705C, el registro 8 (copia 0xFFE7 and 8, or 0x22) y, con el V9958, el 25 = 2
L 0x6D95 scroll_del_cuadro en la fase 4 (y cada 4 cuadros en la 8) cambia de pagina (p09:6DC3); p09:7203 y p09:7AB5; y segun 0xC0D4: 0 el scroll (p09:7AC4, p09:7755), 1 los graficos de p10:800F, 2 para el scroll, 3 o mas p09:6E08
L 0x6DBD cada_4_cuadros p09:6DC3 solo cuando la cuenta de cuadros and 3 es 0
L 0x6DC3 pagina_siguiente si no hay un cambio pendiente (0xC0B5) y 0xC0B4 es menor que 4: 0xC0DB pasa de 0 a 5 y pide la pagina (0, 1, 2, 3, 2, 1) en 0xC0B5 con el bit 7
L 0x6DEB graficos_y_para los graficos de p10:800F y p09:6DEE
L 0x6DEE para_scroll el scroll fino y lo que se suma a los actores (0xCA12-0xCA1C) a 0, 0xC0D5 = 0 y 0xC0D4 + 1
L 0x6E08 scroll_de_c0dc_y_borra 0xCA12 y 0xCA14 de 0xC0DC (p09:6E37) y borra el trozo de mapa de 0xD988 (p09:6E0B)
L 0x6E0B borra_mapa_d988 24 filas de 32 bytes (de 0x30 en 0x30) desde 0xD988 a 0
L 0x6E2D borra_e000 0xE000-0xE7FF a 0
L 0x6E37 scroll_de_c0dc 0xCA12 = 0xC0DC y 0xCA14 = 0xC0DE
L 0x6E44 pantalla_del_cuadro p09:7070, los registros del scroll en la tabla que toca (p09:6F43), p09:707E, las estrellas de la fase 0 o 2, p09:7683, 0xC09C = 1 (cambiar de tablas) y el fundido pendiente (bits 7 y 6 de 0xEF60)
L 0x6E77 estrellas_al_azar 0xC0EA = 0 y 24 columnas al azar (0-31) en 0xE800-0xE817
L 0x6E8A estrellas_fase_0 las estrellas (p09:6E9C) hacia la derecha con el caracter 0xCD
L 0x6E91 sin_estrellas 0xC0EA = 1
L 0x6E97 estrellas_fase_2 las estrellas hacia la izquierda con el caracter 0x5F
L 0x6E9C estrellas_del_cuadro mueve las estrellas con el scroll (0xC0E6, 0xC0E8) y pone el caracter B en las 24 filas del mapa de 0xD988 donde esta vacio, dos por fila
L 0x6F20 rota_estrellas las 24 columnas de 0xE800 giran una posicion (segun 0xC0D5, hacia un lado o hacia el otro)
L 0x6F43 registros_de_scroll con 0xC0D2 y 0xC0BB, los valores del scroll en una de las dos tablas de registros (0xC9C5-0xC9CF o 0xC9F1-0xC9FB); con el V9958, de otra forma
L 0x6F99 tablas_de_registros copia las listas de registros de p09:7002-705B a las seis tablas de 0xC948-0xC9FF (las que mandan las interrupciones de linea) con el registro 8 de 0xFFE7 y, con el V9958, el 0x9B
L 0x7070 paleta_retrasada baja 0xC0D8 y, al llegar a 0, manda la paleta (p00:4DA9)
L 0x707D nada_707D ret
L 0x707E sprites_del_cuadro reparte los sprites por franjas (p09:7221) y manda sus atributos a la VRAM (p09:70E4)
L 0x7085 borra_sprites_ram 0xC000-0xC07F, 0xC180-0xC1FF y 0xC280-0xC2FF a 0
L 0x70E4 manda_sprites segun la tabla del cuadro (0xC09B): los atributos de 0xC4B9 y 0xC5B9 a 0xFA00 y 0xFE00 de la VRAM, o los de 0xC1C1 y 0xC2C1 a 0xF200 y 0xF600 (p09:713F)
L 0x70F7 manda_atributos_a apunta la VRAM a HL y manda los atributos de DE (p09:7106); HL + 0x400
L 0x7106 manda_atributos_a_b dos tandas de p09:7117
L 0x7117 manda_atributos_a_c 4 veces 8 + 8 bytes con otir, saltando 16 hacia atras entre ellas
L 0x713F manda_sprites_b los atributos de 0xC1C1 y 0xC2C1 a 0xF200 y 0xF600
L 0x714B manda_atributos_b apunta la VRAM a HL y manda los atributos de DE (p09:715A); HL + 0x400
L 0x715A manda_atributos_b_b dos tandas de p09:7165
L 0x7165 manda_atributos_b_c 4 veces 16 bytes con otir
