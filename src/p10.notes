# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
C 0x8008 entrada_de_tabla: HL = la palabra A de la tabla de HL
C 0x8012 lee la fase (0 a 8; 9 el final)
C 0x8018 entrada_de_tabla: HL = la palabra A de la tabla de HL
C 0x8029 apunta a lo que es cada caracter del fondo: bit 0 solido, bit 2 mira los actores
C 0x8032 apunta a lo que es cada caracter del fondo: bit 0 solido, bit 2 mira los actores
C 0x806C prepara_paleta: espera al fundido de antes y apunta como destino los colores de la lista de HL (p00:4D01); al llegar a un byte 0xF0 o mayor, 0xEF60 = 0x80
C 0x80FB trozo_de_vram_4: la direccion de VRAM del trozo A x 4 (p00:4E8A) con 0xC93E a 0
C 0x8162 entrada_de_tabla: HL = la palabra A de la tabla de HL
C 0x826A trozo_de_vram: HL = 0x4000 x (A / 4) + 0x0800 x (A and 3) + 0x100 x 0xC93E, y A = 0xFF (64 KB altos) si el trozo pasa de 12 (p00:4EA9)
C 0x8270 apunta a el mapa de caracteres de la pantalla: 0x30 por fila, con 8 de margen (p04:7B18)
C 0x8277 copia_a_vram: copia BC bytes de HL a la VRAM en DE; el bit 0 de A es el bit 16 de la direccion
C 0x827B apunta a el mapa de caracteres de la pantalla: 0x30 por fila, con 8 de margen (p04:7B18)
C 0x8287 apunta a el mapa de caracteres de la pantalla: 0x30 por fila, con 8 de margen (p04:7B18)
C 0x82C5 guarda el banco que lee el RLE de p10:8290 en 0xA000
C 0x82C8 banco_en_A000: pone el banco A en 0xA000
C 0x82DC lee el banco que lee el RLE de p10:8290 en 0xA000
C 0x82E0 guarda el banco que lee el RLE de p10:8290 en 0xA000
C 0x82E3 banco_en_A000: pone el banco A en 0xA000
C 0x831B apunta a el mapa de caracteres de la pantalla: 0x30 por fila, con 8 de margen (p04:7B18)
C 0x8345 apunta a el mapa de caracteres de la pantalla: 0x30 por fila, con 8 de margen (p04:7B18)
C 0x8371 lee la fase (0 a 8; 9 el final)
C 0x837D borra_memoria: pone a 0 BC + 1 bytes desde HL
C 0x83B6 lee la fase (0 a 8; 9 el final)
C 0x83BC entrada_de_tabla: HL = la palabra A de la tabla de HL
C 0x83F2 apunta a el mapa de caracteres de la pantalla: 0x30 por fila, con 8 de margen (p04:7B18)
C 0x83F9 copia_a_vram_baja: copia BC bytes de HL a la VRAM en DE, en los 64 KB bajos
