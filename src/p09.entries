0x7A1C   # p09:7871 entrada 6 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A23   # p09:7871 entrada 7 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A30   # p09:7871 entrada 8 de la tabla de 0x7874 (call 0x461A en 0x7871)
