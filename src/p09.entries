0x7A54   # p09:7871 entrada 10 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A65   # p09:7871 entrada 11 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A6A   # p09:7871 entrada 12 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A80   # p09:7871 entrada 13 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A87   # p09:7871 entrada 14 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7A94   # p09:7871 entrada 15 de la tabla de 0x7874 (call 0x461A en 0x7871)
0x7C6D   # p09:7C58 entrada 8 de la tabla de 0x7C5B (call 0x461A en 0x7C58)
0x7D88   # p09:7C58 entrada 2 de la tabla de 0x7C5B (call 0x461A en 0x7C58)
