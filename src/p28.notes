# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6000 vector_inicia_sonido jp p28:6009
L 0x6003 vector_pide_sonido jp p28:6929 (el sonido de A)
L 0x6006 vector_paso_del_sonido jp p28:6AD6
L 0x6009 inicia_sonido marca todos los registros del SCC como cambiados (0xC85F = 0xFFFF, 0xC861-0xC86F = 1), los manda (p28:6287) y el mezclador del PSG a 0xBF
L 0x6024 manda_todo los registros del PSG (p28:602B) y los del SCC (p28:6123)
L 0x602B manda_psg p28:603B, tonos y volumenes (p28:6053), ruido (p28:6088), envolvente (p28:60B5) y mezclador (p28:60E3)
L 0x603B psg_ab_libre si los canales del PSG de 0xC60D y 0xC68D tienen el bit 0, quita los bits 0 y 1 de 0xC60D
L 0x6053 tonos_y_volumenes_psg los tres canales del PSG (0xC60A, 0xC64A, 0xC68A) a los registros 0-5 y 8-10 (p28:606A)
L 0x606A canal_psg el tono (dos registros) y el volumen del canal de HL; con el bit 2 de la casilla 3, la envolvente una vez (bit 3)
L 0x6088 ruido_psg el registro 6 (ruido) con 0xC859 o 0xC85A segun las banderas de 0xC85B
L 0x60B5 envolvente_psg los registros 11, 12 y 13 con 0xC85D, 0xC85E y 0xC85C si las banderas 7, 6 y 5 de 0xC85B lo piden
L 0x60E3 mezclador_psg el registro 7 con los bits de las tablas p28:6117, p28:611B y p28:611F segun cada canal; copia en 0xC880
L 0x6106 pon_mezclador el registro 7 = A (copia en 0xC880)
L 0x6110 entrada_de_4 HL + (A and 3)
L 0x6123 manda_scc mira que ha cambiado (p28:6130), los canales encendidos (p28:6235), las frecuencias y volumenes (p28:6287) y las formas de onda (p28:6348)
L 0x6130 cambios_scc compara la frecuencia y el volumen de los 5 canales del SCC (0xC6CA, 0xC70A, 0xC74A, 0xC78A, 0xC7CA) con sus copias de 0xC861 y 0xC86B y marca en 0xC85F-0xC860 los que han cambiado
L 0x6235 canales_encendidos_scc los bits de los canales con volumen en 0xC870 y, si cambia, el bit 7 de 0xC860
L 0x6287 registros_scc cada registro marcado de 0xC861 a su sitio del SCC (0x9880-0x988F, p28:633F)
L 0x633F escribe_registro_scc con el SCC puesto (p28:642E), (DE) = (HL) y vuelve el banco 29
L 0x6348 formas_de_onda las formas de onda nuevas de los canales 1 a 4 del SCC (0xC6C0, 0xC700, 0xC740, 0xC780; bit 7 de ix+0x0F): 32 bytes de ix+0x27 a 0x9800, 0x9820, 0x9840, 0x9860
L 0x63FD copia_onda con los canales apagados mientras (0x988F), 32 bytes de HL a DE y vuelven los encendidos
L 0x6418 copia_onda_saltando 32 bytes de HL a DE avanzando ix+0x31 cada vez
L 0x642E enciende_scc 0x3F en 0x9000: los registros del SCC en 0x9800
L 0x6434 banco_29_en_8000 el banco 29 en 0x8000
L 0x643A escribe_psg el registro A del PSG = E (puertos 0xA0 y 0xA1)
L 0x68FA banco_de_la_musica a los sonidos 0x39-0x52 (las musicas) les toca el banco de la tabla p28:690F en 0xC8C8
L 0x6929 pide_sonido sin interrupciones y guardando los registros, p28:693F
