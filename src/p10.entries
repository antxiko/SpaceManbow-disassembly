# Puntos de entrada del banco 10 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador (cartucho.DESPACHADOR), que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8000   # p09:6D0C jp
0x8004   # se ejecuta jugando (tools/cobertura.py): se llega desde p10:822D (ret)
0x800B   # se ejecuta jugando (tools/cobertura.py): se llega desde p00:4698 (ret)
0x800E   # se ejecuta jugando (tools/cobertura.py): se llega desde p10:8068 (ret)
0x800F   # p09:6D09 jp
0x801F   # p09:6D00 jp
0x80F4   # p09:6D03 jp
0x80F8   # codigo huerfano: 87 bytes que acaban en ret; el trazado no entra y ninguna instruccion salta, llama o carga 0x80F8
0x814F   # codigo huerfano: 8 bytes que acaban en ret; el trazado no entra y ninguna instruccion salta, llama o carga 0x814F
0x8157   # codigo huerfano: 8 bytes que acaban en ret; el trazado no entra y ninguna instruccion salta, llama o carga 0x8157
