# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6000 vector_programa jp p01:6021
L 0x6003 vector_6BD6 jp p01:6BD6
L 0x6006 vector_6B33 jp p01:6B33
L 0x6009 vector_6C6A jp p01:6C6A
L 0x6021 programa cuenta 0xC903 y salta por el estado 0xC900 (tabla p01:6032): 0 arranque, 1 logotipo, 2 titulo, 3 historia, 4 partida, 5 demostracion; 0xC901 es el paso dentro del estado
L 0x603E estado_arranque prepara el VDP (p00:4725) y pasa al estado 1
L 0x604B a_demostracion pasa al estado 5, la demostracion
L 0x6050 estado_logotipo si se pulsa algo pasa al titulo (p01:623D); si no, el paso de 0xC901 (tabla p01:605F)
L 0x6065 logotipo_prepara borra 0xD700-0xD70F, prepara el logotipo (p01:6664) y siguiente paso
L 0x607B logotipo_anima un paso del logotipo (p01:6707); cuando 0xD702 lo dice, 0xC904 = 0x80 y siguiente paso
L 0x6096 espera_y_sigue baja 0xC904 y, al llegar a 0, pasa al estado siguiente
L 0x609D estado_titulo el paso de 0xC901 (tabla p01:60A6)
L 0x60AA titulo_prepara una espera, p01:6981 y siguiente paso
L 0x60C6 titulo_sigue una espera, p01:6994 y siguiente estado
L 0x60DB estado_historia el paso de 0xC901 (tabla p01:60E4)
L 0x60E8 historia p01:6A92, p03:A65B, y tres pantallas de texto (p01:6C6A con p01:615D y p01:616C) con su paleta (p01:6157), 0xF0 cuadros cada una; borra la VRAM y siguiente paso
L 0x6157 paleta_y_fundido los colores de HL como destino (p00:4CE0) y empieza el fundido
L 0x6199 historia_sigue p03:A6A5 y, cuando vuelve con NZ, pasa al estado 5 (la demostracion)
L 0x61B0 estado_partida el paso de 0xC901 (tabla p01:61B9)
L 0x61BD partida_prepara p01:64AC y siguiente paso
L 0x61D0 partida_cuadro un cuadro de la partida (p01:6256)
L 0x61E2 estado_demostracion la demostracion: el paso de 0xC901 (tabla p01:61EB)
L 0x61EF demostracion_prepara p01:77B5 y siguiente paso
L 0x6202 demostracion_cuadro un cuadro de la demostracion (p01:77F0); cuando acaba (Z), al estado 0
L 0x6216 siguiente_paso_y_0 0xC904 = 0 y siguiente paso
L 0x6217 siguiente_paso_con_a 0xC904 = A y siguiente paso
L 0x621A siguiente_paso 0xC901 + 1
L 0x621F siguiente_estado 0xC900 + 1, paso 0 y 0xC904 = 0
L 0x622C a_estado_0 al estado 0
L 0x622D a_estado al estado A, paso 0
L 0x6238 baja_c904 0xC904 - 1; Z al llegar a 0
L 0x623D pulsado_al_titulo si se ha pulsado algo (0xC907), al estado 2 (titulo) con acarreo
L 0x6249 mandos_en_c921 los mandos (p00:4A8C) en 0xC921 y lo recien pulsado en 0xC920
L 0x6256 partida 0xCA02 + 1 y salta por el estado de la partida 0xCA00 (tabla p01:6267), con su paso en 0xCA01
L 0x6271 partida_estado_0 el paso de 0xCA01
L 0x627E partida_0_0 siguiente paso de la partida (p01:64A7)
L 0x6288 partida_0_1 al estado 1 de la partida (p01:649E)
L 0x6292 partida_estado_1 el paso de 0xCA01
L 0x629F partida_1_0 siguiente paso de la partida
L 0x62B0 partida_1_1 al estado siguiente de la partida
L 0x62C1 partida_estado_jugando el paso de 0xCA01 (tabla p01:62CA)
L 0x62D0 empieza_la_fase paleta a negro y la fase empieza (p00:4103 con A = 0)
L 0x62E8 jugando un cuadro de partida (p00:4100): 0 sigue; 1 nave muerta, al estado 3 de la partida; 2 fase acabada, siguiente paso
L 0x6300 sonidos_si 0xC947 = 0
L 0x6308 fase_siguiente 0xCA10 + 1; despues de la 8, al estado 4 (el final); si no, la fase empieza (p00:4103 con A = 3)
L 0x632D partida_estado_muerte el paso de 0xCA01 (tabla p01:6336)
L 0x6340 resta_vida una vida menos (0xCB0F, BCD): si quedan, la fase vuelve a empezar (p00:4103 con A = 1); si no, siguiente paso
L 0x6367 fin_de_partida 0xCA02 = 0x60, el sonido 0x4B, borra la pantalla (p01:63EE) y escribe los dos textos (p01:641E, p01:6428) con sus colores
L 0x6399 fin_de_partida_espera con F5 (bit 4 de 0xC90C) se sigue (p01:63AF); si no, al acabar la cuenta de 0xCA02, siguiente paso
L 0x63AF sigue_la_partida escribe el texto de p01:6437, sus colores, y prepara seguir (p01:63D5)
L 0x63C7 vuelve_al_arranque prepara el arranque (p00:49E3) y al estado 0
L 0x63D5 sigue_la_partida_b al acabar la cuenta, la fase vuelve a empezar (p00:4103 con A = 2)
L 0x63E8 paleta_y_fundido_b igual que p01:6157
L 0x63EE pantalla_limpia los 6 registros del VDP de p01:6405, sin sprites y la VRAM borrada
L 0x6440 secuencia_entre_fases guarda 0xCA00-0xCFFF en 0xC000, hace la secuencia de p03 (p01:647C), borra la RAM de la partida y la devuelve; fase 0, 0xCA04 + 1 (sin pasar de 0xFF), la fase empieza (p00:4103 con A = 3) y la partida al estado 2, paso 1
L 0x647C secuencia_de_p03 0xC947 = 0, p03:A62A y p03:A69F cada cuadro hasta que vuelve con NZ; paleta a negro
L 0x6492 estado_de_partida_hl 0xCA00 = HL (estado y paso)
L 0x6496 a_estado_de_partida 0xCA00 = A y paso 0
L 0x649E siguiente_estado_de_partida 0xCA00 + 1 y paso 0
L 0x64A3 paso_de_partida_a 0xCA01 = A
L 0x64A7 siguiente_paso_de_partida 0xCA01 + 1
L 0x64AC prepara_partida borra 0xCA00-0xEFFF; la fase de 0xF0FC (solo en el estado 4) y 0xCA03 = 0; con el byte 0x4032 distinto de 0xFF y F3 pulsada, el bit 0 de 0xCA03
L 0x64F6 copia_fuente_653C con 0xFAF6 = 1: 16 caracteres de p01:665C (p01:6960) y la fuente de p01:653C a la VRAM (p01:692E)
L 0x6530 letra_de_la_bios HL = la letra A de la fuente de la BIOS (la direccion de 0x0004 + 8 x A)
L 0x6664 prepara_logotipo prepara el arranque, apaga la pantalla, la paleta (p01:66D6), el borde, el registro 7, un rectangulo, los graficos del logotipo (p01:678E, p01:67F6, p01:685E con p01:692E), el texto de p01:674D y enciende; 0xD700 = 0x3C, 0xD701 = 0x31, 0xD702 = 0
L 0x6707 paso_del_logotipo cada dos cuadros, una linea mas del logotipo (copia de la VRAM, p00:4838) hasta que 0xD701 llega a 0 y 0xD702 = 1
L 0x672D texto_por_columnas las letras de HL con p00:49B9 hasta un 0xFF; 0xFE trae cuanto se mueve D y baja E 8 puntos
L 0x692E copia_letras B letras de 1 bit por punto de HL a la VRAM (p01:6960), una detras de otra
L 0x693A de_1_a_4_bits pasa 8 filas de un caracter de 1 bit por punto (HL) a 4 bits por punto en 0xD800, con el color C
L 0x6960 letra_a_vram una letra de HL a 4 bits (p01:693A) y a la VRAM en D, E (p00:490B)
L 0x6981 titulo_prepara_b pantalla limpia, el gancho que salta a la partida con el disparo (p01:6A98) y p03:A600
L 0x6994 titulo_aparece pantalla limpia, el titulo subiendo con el registro 23 (de 0xE8 a 0, un paso por cuadro), sus copias, colores y textos, p03:A651 y el gancho normal (p01:6A84)
